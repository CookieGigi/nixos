# =============================================================================
# secrets.yaml — Encrypted secrets
# =============================================================================
#
# 👆 DO NOT edit this file directly. To add or change secrets:
#    nix-shell -p sops --run "sops secrets/secrets.yaml"
#
# This is the PLAINTEXT template before encryption.
# After you encrypt it with sops, the real secrets.yaml will look encrypted.

# User password hash — generate with:
#   nix-shell -p mkpasswd --run 'echo "your-password" | mkpasswd -s'
user-password: PLACEHOLDER

# Immich Postgres password — generate with:
#   nix-shell -p pwgen --run 'pwgen -s 32 1'
# (use only A-Za-z0-9 to avoid Docker/Podman parsing issues)
immich-db-password: PLACEHOLDER

# GPG private key for proton-drive pass credential store.
# Generate with: gpg --full-generate-key
# Export with:   gpg --export-secret-keys --armor <KEY_ID> > /tmp/pass-gpg-key.asc
# Then edit with: sops secrets/secrets.yaml
pass-gpg-key: PLACEHOLDER
