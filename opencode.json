{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "nix": {
      "command": ["nix", "fmt", "."],
      "extensions": [".nix"]
    }
  },
  "lsp": {
    "nix": {
      "command": ["nil"],
      "extensions": [".nix"]
    }
  },
  "skills": {
    "paths": [".opencode/skills", "/home/cookiegigi/.config/opencode/skills"]
  },
  "mcp": {
    "huggingface": {
      "type": "remote",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer {file:/run/secrets/hf-token}"
      },
      "enabled": true,
      "timeout": 30000
    }
  },
  "plugin": ["@tarquinen/opencode-dcp@latest"],
  "instructions": [
    "AGENTS.md",
    "README.md",
    "flake.nix"
  ]
}
