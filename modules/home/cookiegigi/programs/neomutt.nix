{pkgs, ...}: let
  # OpenPGP key protecting both transport encryption and the password store
  # (see ./gpg.nix). This is the fingerprint `pass init` was given.
  key = "0CED606EA710CFB8F3E0D3EA4A33EE78D76EF538";

  address = "gcreusot@posteo.com";

  # The mailbox password is never written here: it is read from pass at
  # runtime, and gpg-agent caches the decryption for an hour.
  neomuttrc = ''
    # NeoMutt — Posteo (IMAP/SMTP) + OpenPGP through GnuPG.
    # Generated by modules/home/cookiegigi/programs/neomutt.nix.

    # ── Identity ──────────────────────────────────────────────────────────
    set from = "${address}"
    set real_name = "gcreusot"
    set use_from = yes
    set use_envelope_from = yes

    # ── IMAP ──────────────────────────────────────────────────────────────
    set folder = "imaps://posteo.de:993/"
    set spool_file = "+INBOX"
    set imap_user = "${address}"
    set imap_pass = "`pass show mail/posteo`"
    set ssl_force_tls = yes

    # ── SMTP ──────────────────────────────────────────────────────────────
    # NeoMutt splits the URL at its last "@", so an address used as login is
    # repeated before the host.
    set smtp_url = "smtps://${address}@posteo.de:465/"
    set smtp_pass = "`pass show mail/posteo`"

    # ── Posteo special folders ────────────────────────────────────────────
    # Posteo names these after the webmail language. A German account needs
    # Gesendet / Entwürfe / Papierkorb instead.
    set record = "+Sent"
    set postponed = "+Drafts"
    set trash = "+Trash"

    # ── OpenPGP (GPGME -> gpg-agent -> pinentry-qt) ───────────────────────
    set crypt_use_gpgme = yes
    set pgp_default_key = "${key}"
    set pgp_sign_as = "${key}"
    set pgp_self_encrypt = yes
    set crypt_verify_sig = yes
    set crypt_reply_encrypt = yes
    set crypt_reply_sign = yes
    # Nothing is signed or encrypted behind your back: toggle per message in
    # the compose menu with "p" (encrypt) and "s" (sign).
    set crypt_auto_encrypt = no
    set crypt_auto_sign = no
    set crypt_confirm_hook = yes
    set crypt_protected_headers_read = yes

    # ── HTML mail ─────────────────────────────────────────────────────────
    set mailcap_path = "~/.config/neomutt/mailcap:/etc/mailcap"
    set implicit_auto_view = yes
  '';
in {
  home.packages = [
    pkgs.neomutt
    # HTML part renderer referenced by the mailcap below.
    pkgs.w3m
  ];

  xdg.configFile."neomutt/neomuttrc".text = neomuttrc;

  xdg.configFile."neomutt/mailcap".text = ''
    text/html; ${pkgs.w3m}/bin/w3m -dump -T text/html %s; copiousoutput
  '';
}
